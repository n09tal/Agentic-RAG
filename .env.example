# Copy this file to .env and replace the placeholder password.
# .env is git-ignored; never commit real secrets.

# Used by docker-compose.yml to create the local database
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentic_rag
POSTGRES_PORT=5433

# Used by the backend to connect (must match the values above)
DATABASE_URL=postgresql://rag:change-me@127.0.0.1:5433/agentic_rag

# Gemini API (put the real key only in .env, never commit it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash